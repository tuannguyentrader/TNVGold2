# ============================================================
# TNVGold Telegram Bot — Cấu hình hệ thống (KHÔNG chứa API key)
# ============================================================
# API key AI được quản lý qua lệnh /keys trong Telegram (lưu SQLite).
# File này chỉ chứa cấu hình hệ thống, dùng cho systemd.
# Copy thành tnvgold.env trên VPS (hoặc export trực tiếp).

# ── Telegram ─────────────────────────────────────────────
# Token bot (bắt buộc) — hoặc tạo file telegram_token.txt
TELEGRAM_BOT_TOKEN=

# Chat id được phép dùng bot (cách dấu phẩy). Rỗng = ai cũng dùng được.
ALLOWED_CHAT_IDS=

# Chat id nhận báo cáo tự động (cách dấu phẩy)
XAU_CHAT_IDS=

# ── Nguồn dữ liệu ────────────────────────────────────────
# MT5_MODE: local | bridge | fallback
#   local    = MT5 chạy trên cùng máy (cần Wine + MetaTrader5)
#   bridge   = MT5 trên máy khác gửi webhook (TNVGold WebBridge)
#   fallback = lấy giá từ Gold-API (free, không giới hạn)
MT5_MODE=fallback

# ── Collector ────────────────────────────────────────────
# Poll interval (giây) — mặc định 60s
POLL_INTERVAL=60
# Nến M5 (phút)
CANDLE_MINUTES=5

# ── Báo cáo định kỳ ──────────────────────────────────────
HOURLY_BRIEF=1
DAILY_REPORT_HOURS=7,19

# ── Bridge (nếu MT5_MODE=bridge) ─────────────────────────
BRIDGE_PORT=5005
